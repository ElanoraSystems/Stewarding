# Copy to .env and fill in. Never commit .env.
# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=
# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
STW_SECRET_KEY=
# Public address(es) the browser loads the app from, comma separated.
STW_CORS_ORIGINS=http://localhost:8080
STW_TOKEN_MINUTES=600
WEB_PORT=8080
