STW_DATABASE_URL=sqlite:///./stewarding.db
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STW_SECRET_KEY=
STW_TOKEN_MINUTES=600
STW_CORS_ORIGINS=http://localhost:5173
# Optional: password for seeded demo users. A random one is generated and printed when empty.
STW_SEED_PASSWORD=
